	<include name="NovaMQMenuBarVertical">
		<control type="group">
			<!-- vertical panel composition (MQ9 draws its vertical backs at 538x2160; Nova fits them to its
			     340-wide menu panel). Colour diffuse = the ported bar colour, as in MQ9. -->
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>340</width>
				<height>1080</height>
				<texture colordiffuse="$VAR[NovaMenuBarColorVar]">$VAR[NovaMenuBarVerticalBackVar]</texture>
				<visible>String.IsEqual(Skin.String(NovaMenuBarStyle),v32) | String.IsEqual(Skin.String(NovaMenuBarStyle),v33) | String.IsEqual(Skin.String(NovaMenuBarStyle),v35) | String.IsEqual(Skin.String(NovaMenuBarStyle),v36)</visible>
			</control>
			<!-- vertical border overlay (MQ9 draws it for styles 32/33 only) -->
			<control type="image">
				<left>0</left>
				<top>0</top>
				<width>340</width>
				<height>1080</height>
				<texture>$VAR[NovaMenuBarVerticalBorderVar]</texture>
				<visible>String.IsEqual(Skin.String(NovaMenuBarStyle),v32) | String.IsEqual(Skin.String(NovaMenuBarStyle),v33)</visible>
			</control>
			<!-- style v34 (AEON MQ 8 VERTICAL 3): MQ9 draws the MQ8 bar flipped as a band at MQ top 1200 h 170 -->
			<control type="image">
				<left>0</left>
				<top>600</top>
				<width>1920</width>
				<height>85</height>
				<texture flipy="true" colordiffuse="$VAR[NovaMenuBarColorVar]">mainmenu_styles/vertical/34_back.png</texture>
				<visible>String.IsEqual(Skin.String(NovaMenuBarStyle),v34)</visible>
			</control>
		</control>
	</include>
