				<texture colordiffuse="$VAR[NovaMenuBarColorVar]">mainmenu_styles/horizontal/$INFO[Skin.String(NovaMenuBarStyle)]_back.png</texture>
				<visible>String.IsEqual(Skin.String(NovaMenuBarStyle),1) | String.IsEqual(Skin.String(NovaMenuBarStyle),2)</visible>
			</control>
			<!-- static back, MQ group B (styles 3,4,5,6,32): MQ top 1730 h 430 -->
