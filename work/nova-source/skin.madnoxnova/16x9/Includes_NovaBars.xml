				<visible>String.IsEqual(Skin.String(NovaMenuBarStyle),3) | String.IsEqual(Skin.String(NovaMenuBarStyle),4) | String.IsEqual(Skin.String(NovaMenuBarStyle),5) | String.IsEqual(Skin.String(NovaMenuBarStyle),6) | String.IsEqual(Skin.String(NovaMenuBarStyle),32)</visible>
