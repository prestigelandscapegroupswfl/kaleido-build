<?xml version="1.0" encoding="utf-8" ?>
<includes>
	<!-- NOVA-BARS (21.11.5): styled progress bars for Skin.String(NovaBarStyleProgress).
	     One parameterized definition renders one progress bar; the CALLER issues one include call per style,
	     gated by an include condition on the style string, passing geometry/texture params per style:
	       classic (string empty or "classic") : wraptop 0, wrapheight 20, progtop 0, progheight 20, stock textures, border 8
	       slim                                : wraptop 0, wrapheight 20, progtop 5, progheight 10, stock textures, border 8
	       bold                                : wraptop -8, wrapheight 36, progtop 0, progheight 36, stock textures, border 8
	       rounded                             : classic geometry, nova_* rounded textures, border 10
	       glow                                : wraptop -14, wrapheight 48, progtop 14, progheight 20, stock textures + glowvisible=true
	     All styles keep the bar's centre on the classic band centre (y=10 in caller coordinates), and the 21.11.4
	     color strings arrive as the midcolor/bgcolor/glowcolor params, so a picked color composes on top of the
	     picked style. With the style classic and the color strings empty, the rendered bar is the pre-21.11.4 one:
	     same rect the Defaults.xml progress default produced (top 0, height 20), same textures, same diffuses.
	     The glow element is an UNDERLAY: a soft gradient strip behind the whole bar, tinted by glowcolor — it is
	     not clipped to the progress fraction. -->
	<include name="NovaBarProgress">
		<param name="visible">true</param>
		<param name="info">Player.Progress</param>
		<param name="wraptop">0</param>
		<param name="wrapheight">20</param>
		<param name="progtop">0</param>
		<param name="progheight">20</param>
		<param name="midtexture">panels/progress-control/progress-mid.png</param>
		<param name="midborder">8</param>
		<param name="midcolor">$VAR[PanelHighlightColorVar]</param>
		<param name="bgtexture">panels/progress-control/progress-back.png</param>
		<param name="bgborder">8</param>
		<param name="bgcolor">FFFFFFFF</param>
		<param name="glowvisible">false</param>
		<param name="glowcolor">$VAR[PanelHighlightColorVar]</param>
		<param name="fade">false</param>
		<definition>
			<control type="group">
				<visible>$PARAM[visible]</visible>
				<top>$PARAM[wraptop]</top>
				<height>$PARAM[wrapheight]</height>
				<control type="image">
					<visible>String.IsEqual($PARAM[glowvisible],true)</visible>
					<left>0</left>
					<right>0</right>
					<top>0</top>
					<bottom>0</bottom>
					<texture colordiffuse="$PARAM[glowcolor]">panels/progress-control/nova_glow-strip.png</texture>
				</control>
				<control type="progress">
					<include condition="String.IsEqual($PARAM[fade],true)" content="AnimationVisibleFade" />
					<top>$PARAM[progtop]</top>
					<height>$PARAM[progheight]</height>
					<info>$PARAM[info]</info>
					<texturebg border="$PARAM[bgborder]" colordiffuse="$PARAM[bgcolor]">$PARAM[bgtexture]</texturebg>
					<midtexture border="$PARAM[midborder]" colordiffuse="$PARAM[midcolor]">$PARAM[midtexture]</midtexture>
				</control>
			</control>
		</definition>
	</include>

	<!-- NOVA-BARS (21.11.5): styled progress bar WITHOUT an explicit track — the progress control keeps the
	     Defaults.xml default texturebg (panels/progress-control/progress-back.png, border 8, no diffuse),
	     exactly like the bare controls it replaces. Used for the seek buffer bar, the PVR EPG progress and the
	     music OSD progress in every style EXCEPT "rounded": the rounded call uses NovaBarProgress with the
	     rounded track texture, because a capsule fill over the stock track's small corner radius would overhang. -->
	<include name="NovaBarProgressNoBg">
		<param name="visible">true</param>
		<param name="info">Player.Progress</param>
		<param name="wraptop">0</param>
		<param name="wrapheight">20</param>
		<param name="progtop">0</param>
		<param name="progheight">20</param>
		<param name="midtexture">panels/progress-control/progress-mid.png</param>
		<param name="midborder">8</param>
		<param name="midcolor">$VAR[PanelHighlightColorVar]</param>
		<param name="glowvisible">false</param>
		<param name="glowcolor">$VAR[PanelHighlightColorVar]</param>
		<param name="fade">false</param>
		<definition>
			<control type="group">
				<visible>$PARAM[visible]</visible>
				<top>$PARAM[wraptop]</top>
				<height>$PARAM[wrapheight]</height>
				<control type="image">
					<visible>String.IsEqual($PARAM[glowvisible],true)</visible>
					<left>0</left>
					<right>0</right>
					<top>0</top>
					<bottom>0</bottom>
					<texture colordiffuse="$PARAM[glowcolor]">panels/progress-control/nova_glow-strip.png</texture>
				</control>
				<control type="progress">
					<include condition="String.IsEqual($PARAM[fade],true)" content="AnimationVisibleFade" />
					<top>$PARAM[progtop]</top>
					<height>$PARAM[progheight]</height>
					<info>$PARAM[info]</info>
					<midtexture border="$PARAM[midborder]" colordiffuse="$PARAM[midcolor]">$PARAM[midtexture]</midtexture>
				</control>
			</control>
		</definition>
	</include>

