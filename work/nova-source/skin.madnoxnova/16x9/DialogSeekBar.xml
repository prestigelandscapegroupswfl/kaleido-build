<?xml version="1.0" encoding="utf-8" ?>
<window>
	<visible>Player.Seeking | Player.HasPerformedSeek(3) | [Player.Paused + !Player.Caching] | Player.Forwarding | Player.Rewinding | Player.ShowInfo | Window.IsActive(videoosd) | !String.IsEmpty(PVR.ChannelNumberInput)</visible>
	<visible>Window.IsActive(fullscreenvideo)</visible>
	<visible>!String.IsEmpty(Window(Home).Property(Madnox.SkinReady))</visible>
	<zorder>0</zorder>
	<controls>
		<control type="group">
			<visible>![Window.IsActive(videobookmarks) | Window.IsActive(sliderdialog) | Window.IsActive(pvrosdchannels) | Window.IsActive(pvrchannelguide) | Window.IsActive(teletext) | Window.IsActive(visualisation)]</visible>
			<include content="AnimationSlideBottomWindow">
				<param name="slide">120</param>
			</include>
			<include content="AnimationSlideBottomVisible">
				<param name="slide">120</param>
			</include>
			<control type="group">
				<animation effect="slide" end="0,-84" time="480" condition="Window.IsActive(videoosd) + !Window.IsActive(1111)">Conditional</animation>
				<control type="image">
					<visible>!String.IsEqual(Window(home).Property(CustomSelectGroup),$LOCALIZE[13395]) + !Skin.String(VideoOSDInfo,off) + [Player.ShowInfo | Skin.String(VideoOSDInfo,persistant)]</visible>
					<include>AnimationVisibleFade</include>
					<bottom>106</bottom>
					<width>1920</width>
					<height>700</height>
					<texture>panels/background-gradient.png</texture>
				</control>
				<control type="image">
					<visible>!Skin.HasSetting(VideoOSDDisableClearArt) + [Skin.String(VideoOSDInfo,off) | ![Skin.String(VideoOSDInfo,persistant) | Player.ShowInfo]]</visible>
					<animation effect="fade" end="100" delay="480" time="0" condition="!Player.HasPerformedSeek(3)">visible</animation>
					<include>AnimationVisibleFade</include>
					<bottom>106</bottom>
					<left>20</left>
					<width>400</width>
					<height>225</height>
					<aspectratio align="right" aligny="bottom">keep</aspectratio>
					<texture>$VAR[NowPlayingClearArtVar]</texture>
				</control>
				<include content="PanelWide">
					<param name="top">954</param>
					<param name="toptexture">974</param>
					<param name="topshadow">954</param>
					<param name="height">220</param>
					<param name="heighttexture">200</param>
				</include>
			</control>
			<!-- Clearart Is Visible -->
			<control type="label">
				<visible>!Skin.HasSetting(VideoOSDDisableGenreInfo) + !Skin.HasSetting(VideoOSDDisableClearArt) + !VideoPlayer.HasEpg + [!String.IsEmpty(Player.Art(clearart)) | !String.IsEmpty(Player.Art(tvshow.clearart)) | !String.IsEmpty(Player.Art(artist.clearart)) | !String.IsEmpty(Player.Art(clearlogo)) | !String.IsEmpty(Player.Art(tvshow.poster)) | !String.IsEmpty(Player.Art(artist.clearlogo))] + [Skin.String(VideoOSDInfo,off) | ![Skin.String(VideoOSDInfo,persistant) | Player.ShowInfo]]</visible>
				<animation effect="fade" time="200">Visible</animation>
				<animation effect="fade" end="0" time="200">Hidden</animation>
				<animation effect="fade" end="100" delay="480" time="0" condition="!Player.HasPerformedSeek(3)">visible</animation>
				<animation effect="slide" end="0,-84" time="480" condition="Window.IsActive(videoosd) + !Window.IsActive(1111)">Conditional</animation>
				<left>440</left>
				<bottom>110</bottom>
				<width>800</width>
				<height>40</height>
				<align>left</align>
				<aligny>center</aligny>
				<font>Font21_Cond_Bold</font>
				<textcolor>$VAR[PanelHighlightColorVar]</textcolor>
				<label>$INFO[VideoPlayer.Genre]</label>
			</control>

			<!-- Clearart Is Hidden / Missing -->
			<control type="label">
				<visible>!Skin.HasSetting(VideoOSDDisableGenreInfo) + [Skin.HasSetting(VideoOSDDisableClearArt) | VideoPlayer.HasEpg | [String.IsEmpty(Player.Art(clearart)) + String.IsEmpty(Player.Art(tvshow.clearart)) + String.IsEmpty(Player.Art(artist.clearart)) + String.IsEmpty(Player.Art(clearlogo)) + String.IsEmpty(Player.Art(tvshow.poster)) + String.IsEmpty(Player.Art(artist.clearlogo))]] + [Skin.String(VideoOSDInfo,off) | ![Skin.String(VideoOSDInfo,persistant) | Player.ShowInfo]]</visible>
				<animation effect="fade" time="200">Visible</animation>
				<animation effect="fade" end="0" time="200">Hidden</animation>
				<animation effect="fade" end="100" delay="480" time="0" condition="!Player.HasPerformedSeek(3)">visible</animation>
				<animation effect="slide" end="0,-84" time="480" condition="Window.IsActive(videoosd) + !Window.IsActive(1111)">Conditional</animation>
				<left>20</left>
				<bottom>110</bottom>
				<width>800</width>
				<height>40</height>
				<align>left</align>
				<aligny>center</aligny>
				<font>Font21_Cond_Bold</font>
				<textcolor>$VAR[PanelHighlightColorVar]</textcolor>
				<label>$INFO[VideoPlayer.Genre]</label>
			</control>

			<control type="group">
				<left>25</left>
				<right>25</right>
				<bottom>41</bottom>
				<height>40</height>
				<centerleft>50%</centerleft>
				<!-- NOVA-BARS (21.11.5): PVR EPG progress — styled via NovaBarStyleProgress; colors = NovaBarSeek (21.11.4) -->
				<include condition="String.IsEmpty(Skin.String(NovaBarStyleProgress)) | String.IsEqual(Skin.String(NovaBarStyleProgress),classic)" content="NovaBarProgressNoBg">
					<param name="visible">VideoPlayer.HasEpg</param>
					<param name="info">PVR.EpgEventProgress</param>
					<param name="midcolor">$VAR[NovaBarSeekColorVar]</param>
				</include>
				<include condition="String.IsEqual(Skin.String(NovaBarStyleProgress),slim)" content="NovaBarProgressNoBg">
					<param name="visible">VideoPlayer.HasEpg</param>
					<param name="info">PVR.EpgEventProgress</param>
					<param name="midcolor">$VAR[NovaBarSeekColorVar]</param>
					<param name="progtop">5</param>
					<param name="progheight">10</param>
				</include>
				<include condition="String.IsEqual(Skin.String(NovaBarStyleProgress),bold)" content="NovaBarProgressNoBg">
					<param name="visible">VideoPlayer.HasEpg</param>
					<param name="info">PVR.EpgEventProgress</param>
					<param name="midcolor">$VAR[NovaBarSeekColorVar]</param>
					<param name="wraptop">-8</param>
					<param name="wrapheight">36</param>
					<param name="progheight">36</param>
				</include>
				<include condition="String.IsEqual(Skin.String(NovaBarStyleProgress),rounded)" content="NovaBarProgress">
					<param name="visible">VideoPlayer.HasEpg</param>
					<param name="info">PVR.EpgEventProgress</param>
					<param name="midcolor">$VAR[NovaBarSeekColorVar]</param>
					<param name="midtexture">panels/progress-control/nova_progress-mid-rounded.png</param>
					<param name="midborder">10</param>
					<param name="bgtexture">panels/progress-control/nova_progress-back-rounded.png</param>
					<param name="bgborder">10</param>
				</include>
				<include condition="String.IsEqual(Skin.String(NovaBarStyleProgress),glow)" content="NovaBarProgressNoBg">
					<param name="visible">VideoPlayer.HasEpg</param>
					<param name="info">PVR.EpgEventProgress</param>
					<param name="midcolor">$VAR[NovaBarSeekColorVar]</param>
					<param name="wraptop">-14</param>
					<param name="wrapheight">48</param>
					<param name="progtop">14</param>
					<param name="glowvisible">true</param>
					<param name="glowcolor">$VAR[NovaBarSeekColorVar]</param>
				</include>
				<!-- NOVA-BARS (21.11.5): seek buffer bar — styled via NovaBarStyleProgress; colors = NovaBarSeekBack (21.11.4) -->
				<include condition="String.IsEmpty(Skin.String(NovaBarStyleProgress)) | String.IsEqual(Skin.String(NovaBarStyleProgress),classic)" content="NovaBarProgressNoBg">
					<param name="visible">!VideoPlayer.Content(livetv)</param>
					<param name="info">Player.ProgressCache</param>
					<param name="midcolor">$VAR[NovaBarSeekBackColorVar]</param>
					<param name="midtexture">panels/progress-control/progress-mid-cache.png</param>
				</include>
				<include condition="String.IsEqual(Skin.String(NovaBarStyleProgress),slim)" content="NovaBarProgressNoBg">
					<param name="visible">!VideoPlayer.Content(livetv)</param>
					<param name="info">Player.ProgressCache</param>
					<param name="midcolor">$VAR[NovaBarSeekBackColorVar]</param>
					<param name="midtexture">panels/progress-control/progress-mid-cache.png</param>
					<param name="progtop">5</param>
					<param name="progheight">10</param>
				</include>
				<include condition="String.IsEqual(Skin.String(NovaBarStyleProgress),bold)" content="NovaBarProgressNoBg">
					<param name="visible">!VideoPlayer.Content(livetv)</param>
					<param name="info">Player.ProgressCache</param>
					<param name="midcolor">$VAR[NovaBarSeekBackColorVar]</param>
					<param name="midtexture">panels/progress-control/progress-mid-cache.png</param>
					<param name="wraptop">-8</param>
					<param name="wrapheight">36</param>
					<param name="progheight">36</param>
				</include>
				<include condition="String.IsEqual(Skin.String(NovaBarStyleProgress),rounded)" content="NovaBarProgress">
					<param name="visible">!VideoPlayer.Content(livetv)</param>
					<param name="info">Player.ProgressCache</param>
					<param name="midcolor">$VAR[NovaBarSeekBackColorVar]</param>
					<param name="midtexture">panels/progress-control/nova_progress-mid-cache-rounded.png</param>
					<param name="midborder">10</param>
					<param name="bgtexture">panels/progress-control/nova_progress-back-rounded.png</param>
					<param name="bgborder">10</param>
				</include>
				<include condition="String.IsEqual(Skin.String(NovaBarStyleProgress),glow)" content="NovaBarProgressNoBg">
					<param name="visible">!VideoPlayer.Content(livetv)</param>
					<param name="info">Player.ProgressCache</param>
					<param name="midcolor">$VAR[NovaBarSeekBackColorVar]</param>
					<param name="midtexture">panels/progress-control/progress-mid-cache.png</param>
					<param name="wraptop">-14</param>
					<param name="wrapheight">48</param>
					<param name="progtop">14</param>
					<param name="glowvisible">true</param>
					<param name="glowcolor">$VAR[NovaBarSeekBackColorVar]</param>
				</include>
				<!-- NOVA-BARS (21.11.5): video seek bar — styled via NovaBarStyleProgress; colors = NovaBarSeek / NovaBarSeekBack (21.11.4) -->
				<include condition="String.IsEmpty(Skin.String(NovaBarStyleProgress)) | String.IsEqual(Skin.String(NovaBarStyleProgress),classic)" content="NovaBarProgress">
					<param name="visible">!VideoPlayer.HasEpg + !Player.ChannelPreviewActive</param>
					<param name="info">Player.Progress</param>
					<param name="midcolor">$VAR[NovaBarSeekColorVar]</param>
					<param name="bgcolor">$VAR[NovaBarSeekBackColorVar]</param>
				</include>
				<include condition="String.IsEqual(Skin.String(NovaBarStyleProgress),slim)" content="NovaBarProgress">
					<param name="visible">!VideoPlayer.HasEpg + !Player.ChannelPreviewActive</param>
					<param name="info">Player.Progress</param>
					<param name="midcolor">$VAR[NovaBarSeekColorVar]</param>
					<param name="bgcolor">$VAR[NovaBarSeekBackColorVar]</param>
					<param name="progtop">5</param>
					<param name="progheight">10</param>
				</include>
				<include condition="String.IsEqual(Skin.String(NovaBarStyleProgress),bold)" content="NovaBarProgress">
					<param name="visible">!VideoPlayer.HasEpg + !Player.ChannelPreviewActive</param>
					<param name="info">Player.Progress</param>
					<param name="midcolor">$VAR[NovaBarSeekColorVar]</param>
					<param name="bgcolor">$VAR[NovaBarSeekBackColorVar]</param>
					<param name="wraptop">-8</param>
					<param name="wrapheight">36</param>
					<param name="progheight">36</param>
				</include>
				<include condition="String.IsEqual(Skin.String(NovaBarStyleProgress),rounded)" content="NovaBarProgress">
					<param name="visible">!VideoPlayer.HasEpg + !Player.ChannelPreviewActive</param>
					<param name="info">Player.Progress</param>
					<param name="midcolor">$VAR[NovaBarSeekColorVar]</param>
					<param name="bgcolor">$VAR[NovaBarSeekBackColorVar]</param>
					<param name="midtexture">panels/progress-control/nova_progress-mid-rounded.png</param>
					<param name="midborder">10</param>
					<param name="bgtexture">panels/progress-control/nova_progress-back-rounded.png</param>
					<param name="bgborder">10</param>
				</include>
				<include condition="String.IsEqual(Skin.String(NovaBarStyleProgress),glow)" content="NovaBarProgress">
					<param name="visible">!VideoPlayer.HasEpg + !Player.ChannelPreviewActive</param>
					<param name="info">Player.Progress</param>
					<param name="midcolor">$VAR[NovaBarSeekColorVar]</param>
					<param name="bgcolor">$VAR[NovaBarSeekBackColorVar]</param>
					<param name="wraptop">-14</param>
					<param name="wrapheight">48</param>
					<param name="progtop">14</param>
					<param name="glowvisible">true</param>
					<param name="glowcolor">$VAR[NovaBarSeekColorVar]</param>
				</include>
				<control type="ranges">
					<height>20</height>
					<texturebg border="1" colordiffuse="00FFFFFF">buttons/cutlist.png</texturebg>
					<midtexture colordiffuse="FFBC544B">buttons/cutlist.png</midtexture>
					<info>Player.Cutlist</info>
				</control>
				<control type="ranges">
					<height>20</height>
					<texturebg border="1" colordiffuse="00FFFFFF">buttons/chapter.png</texturebg>
					<righttexture>buttons/chapter.png</righttexture>
					<info>Player.Chapters</info>
				</control>
				<control type="slider" id="401">
					<visible>Player.SeekEnabled + !VideoPlayer.HasEpg + !Player.ChannelPreviewActive</visible>
					<bottom>14</bottom>
					<width>1870</width>
					<height>32</height>
					<centerleft>50%</centerleft>
					<texturesliderbar colordiffuse="00FFFFFF">buttons/slider-focus.png</texturesliderbar>
					<textureslidernib>buttons/slider-focus.png</textureslidernib>
					<textureslidernibfocus>buttons/slider-focus.png</textureslidernibfocus>
				</control>
				<control type="slider" id="402">
					<visible>Player.SeekEnabled + VideoPlayer.HasEpg + !Player.ChannelPreviewActive</visible>
					<bottom>14</bottom>
					<width>1870</width>
					<height>32</height>
					<centerleft>50%</centerleft>
					<texturesliderbar colordiffuse="00FFFFFF">buttons/slider-focus.png</texturesliderbar>
					<textureslidernib>buttons/slider-focus.png</textureslidernib>
					<textureslidernibfocus>buttons/slider-focus.png</textureslidernibfocus>
				</control>
				<control type="label">
					<bottom>-24</bottom>
					<width>350</width>
					<height>40</height>
					<align>left</align>
					<font>Font30_Reg</font>
					<textcolor>$VAR[PanelSubTextColorVar]</textcolor>
					<label>$VAR[VideoOSDTimeVar]</label>
				</control>
				<control type="label">
					<visible>!VideoPlayer.HasEpg</visible>
					<bottom>-24</bottom>
					<right>0</right>
					<width>350</width>
					<height>40</height>
					<align>right</align>
					<font>Font30_Reg</font>
					<textcolor>$VAR[PanelSubTextColorVar]</textcolor>
					<label>$INFO[System.Time,, / ]$INFO[Player.FinishTime]</label>
				</control>
				<control type="label">
					<visible>VideoPlayer.HasEpg</visible>
					<bottom>-24</bottom>
					<right>0</right>
					<width>350</width>
					<height>40</height>
					<align>right</align>
					<font>Font30_Reg</font>
					<textcolor>$VAR[PanelSubTextColorVar]</textcolor>
					<label>$INFO[System.Time,, / ]$INFO[VideoPlayer.EndTime]</label>
				</control>
				<control type="label">
					<centerleft>50%</centerleft>
					<bottom>-24</bottom>
					<width>1220</width>
					<height>40</height>
					<align>center</align>
					<font>Font30_Reg</font>
					<label>$VAR[VideoOSDLabelVar]</label>
					<textcolor>$VAR[PanelTextColorVar]</textcolor>
				</control>
			</control>
		</control>
		<control type="grouplist">
			<visible>!Skin.HasSetting(VideoOSDDisableSeekIcon) + !Player.Caching + [Player.Paused | Player.Forwarding | Player.Rewinding | Player.HasPerformedSeek(3)]</visible>
			<include>AnimationVisibleFade</include>
			<itemgap>20</itemgap>
			<align>center</align>
			<orientation>horizontal</orientation>
			<include>FullScreenDimensions</include>
			<control type="label">
				<width>auto</width>
				<align>center</align>
				<font>Font120_Bold_Caps</font>
				<label>$VAR[VideoOSDSeekLabelVar]</label>
				<textcolor>$VAR[PanelSubTextColorVar]</textcolor>
			</control>
			<control type="label">
				<width>auto</width>
				<align>center</align>
				<font>Font120_Icon</font>
				<label>$VAR[VideoOSDSeekIconVar]</label>
				<textcolor>$VAR[PanelSubTextColorVar]</textcolor>
			</control>
		</control>
		<control type="group">
			<visible>![Window.IsActive(videobookmarks) | Window.IsActive(sliderdialog) | Window.IsActive(pvrosdchannels) | Window.IsActive(pvrchannelguide) | Window.IsActive(teletext) | String.IsEqual(Window(home).Property(CustomSelectGroup),$LOCALIZE[13395])]</visible>
			<animation effect="slide" end="0,-84" time="480" condition="Window.IsActive(videoosd) + !Window.IsActive(1111)">Conditional</animation>
			<include>AnimationVisibleFade</include>
			<animation effect="fade" end="100" time="480">WindowOpen</animation>
			<animation effect="fade" start="100" end="0" time="0">WindowClose</animation>
			<!-- Info Left-->
			<control type="group">
				<visible>!Skin.String(VideoOSDInfo,off) + [Player.ShowInfo | Skin.String(VideoOSDInfo,persistant)]</visible>
				<include>AnimationVisibleFade</include>
				<control type="group">
					<top>571</top>
					<left>15</left>
					<right>15</right>
					<control type="group">
						<control type="group">
							<visible>VideoPlayer.Content(movies) + !Player.IsInternetStream</visible>
							<control type="group">
								<visible>Skin.String(VideoOSDMovieInfo,none)</visible>
								<include>AnimationVisibleFade</include>
								<include content="NowPlayingHomePortraitContent">
									<param name="case">Skin.HasSetting(VideoOSDCase)</param>
									<param name="logo">!Skin.HasSetting(VideoOSDDisableLogo)</param>
									<param name="discart">!Skin.HasSetting(VideoOSDDisableDiscArt)</param>
								</include>
							</control>
							<control type="group">
								<visible>!Skin.String(VideoOSDMovieInfo,none)</visible>
								<include>AnimationVisibleFade</include>
								<include content="NowPlayingHomePortraitContent">
									<param name="right">650</param>
									<param name="case">Skin.HasSetting(VideoOSDCase)</param>
									<param name="logo">!Skin.HasSetting(VideoOSDDisableLogo)</param>
									<param name="discart">!Skin.HasSetting(VideoOSDDisableDiscArt)</param>
								</include>
							</control>
						</control>
						<control type="group">
							<visible>VideoPlayer.Content(episodes) + !Player.IsInternetStream</visible>
							<control type="group">
								<visible>Skin.String(VideoOSDMovieInfo,none)</visible>
								<include>AnimationVisibleFade</include>
								<include content="NowPlayingHomePortraitContent">
									<param name="case">Skin.HasSetting(VideoOSDCase)</param>
									<param name="logo">!Skin.HasSetting(VideoOSDDisableLogo)</param>
									<param name="discart">false</param>
								</include>
							</control>
							<control type="group">
								<visible>!Skin.String(VideoOSDMovieInfo,none)</visible>
								<include>AnimationVisibleFade</include>
								<include content="NowPlayingHomePortraitContent">
									<param name="right">650</param>
									<param name="case">Skin.HasSetting(VideoOSDCase)</param>
									<param name="logo">!Skin.HasSetting(VideoOSDDisableLogo)</param>
									<param name="discart">false</param>
								</include>
							</control>
						</control>
						<control type="group">
							<visible>VideoPlayer.Content(musicvideos) + !Player.IsInternetStream</visible>
							<control type="group">
								<visible>Skin.String(VideoOSDVideoInfo,none)</visible>
								<include>AnimationVisibleFade</include>
								<include content="NowPlayingHomeSquareContent">
									<param name="case">Skin.HasSetting(VideoOSDMusicVideoCase)</param>
									<param name="logo">!Skin.HasSetting(VideoOSDDisableLogo)</param>
									<param name="discart">!Skin.HasSetting(VideoOSDDisableDiscArt)</param>
								</include>
							</control>
							<control type="group">
								<visible>!Skin.String(VideoOSDVideoInfo,none)</visible>
								<include>AnimationVisibleFade</include>
								<include content="NowPlayingHomeSquareContent">
									<param name="right">650</param>
									<param name="case">Skin.HasSetting(VideoOSDMusicVideoCase)</param>
									<param name="logo">!Skin.HasSetting(VideoOSDDisableLogo)</param>
									<param name="discart">!Skin.HasSetting(VideoOSDDisableDiscArt)</param>
								</include>
							</control>
						</control>
						<control type="group">
							<visible>![VideoPlayer.Content(movies) | VideoPlayer.Content(episodes) | VideoPlayer.Content(musicvideos)]</visible>
							<control type="group">
								<visible>Skin.String(VideoOSDVideoInfo,none)</visible>
								<include content="NowPlayingHomeSquareContent">
									<param name="aspect">keep</param>
								</include>
							</control>
							<control type="group">
								<visible>!Skin.String(VideoOSDVideoInfo,none)</visible>
								<include content="NowPlayingHomeSquareContent">
									<param name="right">650</param>
									<param name="aspect">keep</param>
								</include>
							</control>
						</control>
					</control>
				</control>
			</control>
			<!-- Info Right-->
			<control type="group">
				<visible>!Skin.String(VideoOSDInfo,off) + [Player.ShowInfo | Skin.String(VideoOSDInfo,persistant)]</visible>
				<include>AnimationVisibleFade</include>
				<control type="group">
					<top>571</top>
					<left>15</left>
					<right>15</right>
					<control type="group">
						<visible>[VideoPlayer.Content(movies) | VideoPlayer.Content(episodes)] + !Player.IsInternetStream</visible>
						<control type="group">
							<visible>Skin.String(VideoOSDMovieInfo,cast)</visible>
							<include>HomeNowPlayingVideoCast</include>
						</control>
						<control type="group">
							<visible>String.IsEmpty(Skin.String(VideoOSDMovieInfo))</visible>
							<include>HomeNowPlayingPortraitPlot</include>
						</control>
					</control>
					<control type="group">
						<visible>![VideoPlayer.Content(movies) | VideoPlayer.Content(episodes)]</visible>
						<control type="group">
							<visible>String.IsEmpty(Skin.String(VideoOSDVideoInfo))</visible>
							<include>HomeNowPlayingSquarePlot</include>
						</control>
					</control>
				</control>
			</control>
